generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  LEADER
  ADMIN
}

enum VocalPart {
  SOPRANO
  ALTO
  TENOR
  BASS
}

enum AttendanceStatus {
  YES
  MAYBE
  NO
  PENDING
}

enum EventType {
  SERVICE
  REHEARSAL
  WORSHIP_NIGHT
  SPECIAL_EVENT
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         Role         @default(MEMBER)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  attendances  Attendance[]
  assignments  Assignment[]
  eventInvitations EventInvitation[]
  announcements Announcement[] @relation("AnnouncementAuthor")
}

model Choir {
  id            String         @id @default(cuid())
  name          String
  description   String?
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  rehearsals    Rehearsal[]
  songs         Song[]
  announcements Announcement[]
}

model Membership {
  id           String           @id @default(cuid())
  userId       String
  choirId      String
  vocalPart    VocalPart?
  availability AttendanceStatus @default(PENDING)
  joinedAt     DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  choir        Choir            @relation(fields: [choirId], references: [id], onDelete: Cascade)

  @@unique([userId, choirId])
}

model Rehearsal {
  id            String         @id @default(cuid())
  choirId       String
  title         String
  eventType     EventType      @default(REHEARSAL)
  customEventType String?
  recurrenceFrequency String    @default("NONE")
  recurrenceIndex Int           @default(1)
  recurrenceTotal Int           @default(1)
  startsAt      DateTime
  endsAt        DateTime
  location      String
  choir         Choir          @relation(fields: [choirId], references: [id], onDelete: Cascade)
  attendances   Attendance[]
  assignments   Assignment[]
  announcements Announcement[]
  invitations  EventInvitation[]
  eventSongs   EventSong[]
  createdAt     DateTime       @default(now())
}

model Attendance {
  id          String           @id @default(cuid())
  rehearsalId String
  userId      String
  present     Boolean          @default(false)
  status      AttendanceStatus @default(PENDING)
  rehearsal   Rehearsal        @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rehearsalId, userId])
}

model Announcement {
  id          String               @id @default(cuid())
  choirId     String
  title       String
  message     String
  priority    AnnouncementPriority @default(NORMAL)
  createdAt   DateTime             @default(now())
  authorId    String?
  author      User?                @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  choir       Choir                @relation(fields: [choirId], references: [id], onDelete: Cascade)
  rehearsal   Rehearsal?           @relation(fields: [rehearsalId], references: [id])
  rehearsalId String?
}

model Assignment {
  id          String    @id @default(cuid())
  rehearsalId String
  userId      String
  part        String
  note        String?
  rehearsal   Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rehearsalId, userId, part])
}

model EventInvitation {
  id          String    @id @default(cuid())
  rehearsalId String
  userId      String
  createdAt   DateTime  @default(now())
  rehearsal   Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rehearsalId, userId])
}

model Song {
  id         String   @id @default(cuid())
  choirId    String
  title      String
  key        String?
  status     String   @default("LEARN")
  notes      String?
  previewUrl String?
  choir      Choir    @relation(fields: [choirId], references: [id], onDelete: Cascade)
  eventSongs EventSong[]
  createdAt  DateTime @default(now())
}

model EventSong {
  id          String    @id @default(cuid())
  rehearsalId String
  songId      String
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  rehearsal   Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  song        Song      @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([rehearsalId, songId])
}
model Artist{
  id String @id @default(cuid())
  brandId String
  title String
  key String?
  songs String
  albums String?
  concert String?
  createdAt DateTime @default(now())

}
