{
  "name": "elayone-choir",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "db:start": "sh scripts/db-start.sh",
    "db:stop": "sh scripts/db-stop.sh",
    "db:status": "sh scripts/db-status.sh",
    "db:backup": "sh scripts/db-backup.sh",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:deploy": "npm --prefix server exec prisma migrate deploy",
    "db:seed": "npm --prefix server run db:seed",
    "typecheck": "tsc --noEmit",
    "server:install": "npm --prefix server install",
    "server:dev": "npm --prefix server run dev",
    "server:typecheck": "npm --prefix server run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@expo/vector-icons": "^15.1.1",
    "babel-preset-expo": "~57.0.0",
    "capacitor": "^0.5.6",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.16",
    "expo-av": "^16.0.8",
    "expo-document-picker": "^57.0.3",
    "expo-secure-store": "~57.0.3",
    "react": "^19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
